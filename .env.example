# .env.example — Environment Variable Template
# University Auction Bid Management System
#
# INSTRUCTIONS:
#   1. Copy this file to `.env`  (never commit the real .env)
#   2. Fill in the values appropriate for your environment
#   3. The .env file is automatically loaded by python-dotenv (if installed)
#      or you can export variables manually in your shell.
#
# ─────────────────────────────────────────────────────────────────────────────
# NEVER commit real credentials. .env is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask Core ────────────────────────────────────────────────────────────────
# REQUIRED in production. Use a long random string (e.g., `openssl rand -hex 32`)
SECRET_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# The exact origin of the frontend in production.
# In development this defaults to http://localhost:5500
# Example: https://auction.yourschool.edu
FRONTEND_ORIGIN=

# ── Java Auction Engine ───────────────────────────────────────────────────────
# Default: http://localhost:9090
JAVA_ENGINE_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# Optional: override default SQLite path (relative to python-backend/)
# Default: python-backend/database/auction.db
DATABASE_PATH=

# ── File Uploads ──────────────────────────────────────────────────────────────
# Optional: override the upload folder path
# Default: python-backend/uploads/auctions/
UPLOAD_FOLDER=

# ── Admin Credentials (DEV ONLY — changes to real values in prod) ─────────────
# These are ONLY used during first-time seeding of the admin user.
# Default dev values: admin@example.com / admin123
# Change these before deploying to any public or shared environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email / OTP ───────────────────────────────────────────────────────────────
# Gmail SMTP Configuration for OTP Delivery.
# WARNING: MAIL_PASSWORD MUST be a Gmail App Password, NOT your main account password.
# See OTP_SETUP.md for instructions on generating an App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com
